<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow -->
    <item android:left="3dp" android:top="4dp" android:right="-3dp" android:bottom="-4dp">
        <shape>
            <solid android:color="#30000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Frosted white glass — gradient top-to-bottom for sheen -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFFCFEFF"
                android:endColor="#F4F5F8FF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#14000000" />
        </shape>
    </item>
</layer-list>
