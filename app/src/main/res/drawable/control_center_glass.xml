<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow -->
    <item android:left="3dp" android:top="4dp" android:right="-3dp" android:bottom="-4dp">
        <shape>
            <solid android:color="#30000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Frosted white glass -->
    <item>
        <shape>
            <solid android:color="#F4FAFEFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#14000000" />
        </shape>
    </item>
    <!-- Top sheen -->
    <item android:bottom="70%">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#18FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
