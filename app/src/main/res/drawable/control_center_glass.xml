<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow -->
    <item android:left="3dp" android:top="4dp" android:right="-3dp" android:bottom="-4dp">
        <shape>
            <solid android:color="#30000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- White body with subtle red tint -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFF8F4F4" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#22E81123" />
        </shape>
    </item>
</layer-list>
