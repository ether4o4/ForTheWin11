<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow shadow -->
    <item android:left="3dp" android:top="5dp" android:right="-3dp" android:bottom="-5dp">
        <shape>
            <solid android:color="#30000000" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Inner shadow rim -->
    <item android:left="1dp" android:top="2dp" android:right="-1dp" android:bottom="-2dp">
        <shape>
            <solid android:color="#18000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <!-- Glass body — near-white frosted -->
    <item>
        <shape>
            <solid android:color="#EEFFFFFF" />
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#12000000" />
        </shape>
    </item>
    <!-- Top specular highlight -->
    <item android:bottom="55%">
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#28FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
