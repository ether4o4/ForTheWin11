<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep shadow layer -->
    <item android:left="2dp" android:top="4dp" android:right="-2dp" android:bottom="-4dp">
        <shape>
            <solid android:color="#28000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Main glass surface with built-in top sheen via gradient -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F0181820"
                android:endColor="#E6141418" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
