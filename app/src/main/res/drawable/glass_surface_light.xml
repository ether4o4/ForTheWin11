<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow -->
    <item android:left="2dp" android:top="4dp" android:right="-2dp" android:bottom="-4dp">
        <shape>
            <solid android:color="#18000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- White glass body -->
    <item>
        <shape>
            <solid android:color="#F2FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#14000000" />
        </shape>
    </item>
    <!-- Subtle top sheen -->
    <item android:bottom="60%">
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="18dp" android:topRightRadius="18dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
