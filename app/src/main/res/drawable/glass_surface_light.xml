<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft drop shadow -->
    <item android:left="2dp" android:top="4dp" android:right="-2dp" android:bottom="-4dp">
        <shape>
            <solid android:color="#18000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- White glass body with top-to-bottom sheen baked into gradient -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:endColor="#F2F8FFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#14000000" />
        </shape>
    </item>
</layer-list>
