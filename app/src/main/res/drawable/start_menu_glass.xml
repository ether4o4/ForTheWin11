<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer shadow -->
    <item android:left="4dp" android:top="0dp" android:right="-4dp" android:bottom="0dp">
        <shape>
            <solid android:color="#44000000" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Main glass body: dark mica gradient — top lighter for sheen effect -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#F0222226"
                android:endColor="#F0141418" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
            <stroke android:width="1dp" android:color="#28FFFFFF" />
        </shape>
    </item>
</layer-list>
