<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/Selected state: bg-cyan-500/15 with border -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2600D4FF" />
            <stroke android:width="1dp" android:color="#4D00D4FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Hover (Focused) state: bg-white/5 -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default state: Transparent -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
