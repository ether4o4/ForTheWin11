<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:left="1dp" android:top="2dp" android:right="-1dp" android:bottom="-2dp">
        <shape>
            <solid android:color="#28000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Frosted icon bg -->
    <item>
        <shape>
            <solid android:color="#CCF8FEFF" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#18FFFFFF" />
        </shape>
    </item>
    <!-- Top sheen -->
    <item android:bottom="55%">
        <shape>
            <gradient android:type="linear" android:angle="270"
                android:startColor="#22FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
