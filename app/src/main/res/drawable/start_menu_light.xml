<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle shadow -->
    <item android:left="2dp" android:top="0dp" android:right="-2dp" android:bottom="0dp">
        <shape>
            <solid android:color="#18000000" />
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" />
        </shape>
    </item>
    <!-- Main light body with red accent border -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFF8F5F5" />
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp" />
            <stroke android:width="1.5dp" android:color="#33E81123" />
        </shape>
    </item>
</layer-list>
