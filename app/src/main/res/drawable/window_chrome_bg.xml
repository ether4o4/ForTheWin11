<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Window drop shadow -->
    <item android:left="4dp" android:top="8dp" android:right="-4dp" android:bottom="-8dp">
        <shape>
            <solid android:color="#40000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="4dp" android:right="-2dp" android:bottom="-4dp">
        <shape>
            <solid android:color="#20000000" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Main body: bright white glass -->
    <item>
        <shape>
            <solid android:color="#F8FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#16000000" />
        </shape>
    </item>
</layer-list>
