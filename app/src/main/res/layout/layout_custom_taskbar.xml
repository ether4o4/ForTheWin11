<?xml version="1.0" encoding="utf-8"?>
<!-- Win11 portrait taskbar: light pill, centered icons, tray on right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/taskbar_light_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- ── LEFT: Start + Search ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Win logo -->
            <FrameLayout
                android:id="@+id/btn_start_orb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/taskbar_icon_hover"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_start"
                    android:contentDescription="Start" />
            </FrameLayout>

            <!-- Search bar -->
            <LinearLayout
                android:id="@+id/btn_taskbar_search"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/win11_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_win11_search"
                    android:contentDescription="Search" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Search"
                    android:textColor="#99000000"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ── CENTER: Pinned app icons ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Task View -->
            <FrameLayout
                android:id="@+id/btn_taskbar_taskview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_hover"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_taskview"
                    android:contentDescription="Task View" />
            </FrameLayout>

            <!-- File Explorer -->
            <FrameLayout
                android:id="@+id/btn_taskbar_explorer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_hover"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_folder"
                    android:contentDescription="File Explorer" />
            </FrameLayout>

            <!-- Edge -->
            <FrameLayout
                android:id="@+id/btn_taskbar_browser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_hover"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_edge"
                    android:contentDescription="Edge" />
            </FrameLayout>

            <!-- Settings -->
            <FrameLayout
                android:id="@+id/btn_taskbar_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_hover"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_settings"
                    android:contentDescription="Settings" />
            </FrameLayout>

            <!-- Active windows — injected dynamically -->
            <LinearLayout
                android:id="@+id/taskbar_items_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </LinearLayout>

        <!-- ── RIGHT: System tray ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <!-- Tray icons -->
            <LinearLayout
                android:id="@+id/taskbar_system_tray"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/taskbar_icon_hover"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <!-- Network -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_upload"
                    android:rotation="180"
                    android:contentDescription="Network" />

                <!-- Volume -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    android:contentDescription="Volume" />

                <!-- Battery -->
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/ic_lock_idle_low_battery"
                    android:contentDescription="Battery" />

                <!-- Clock + Date stacked -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/taskbar_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4:42 PM"
                        android:textColor="#FF000000"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/taskbar_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/20/2026"
                        android:textColor="#99000000"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Notification badge -->
            <FrameLayout
                android:id="@+id/btn_notifications"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/taskbar_icon_hover"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/notification_count"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:background="@drawable/win11_active_indicator"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
