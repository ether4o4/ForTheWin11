<?xml version="1.0" encoding="utf-8"?>
<!-- Win11 taskbar — squared, full-width, light theme -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Top border line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14000000"
        android:layout_gravity="top" />

    <!-- Main squared bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="1dp">

        <!-- ── LEFT: Start + Search ──────────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Win logo button -->
            <FrameLayout
                android:id="@+id/btn_start_orb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/taskbar_icon_ripple"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_start"
                    app:tint="#FF0078D4"
                    android:contentDescription="Start" />
            </FrameLayout>

            <!-- Search bar -->
            <LinearLayout
                android:id="@+id/btn_taskbar_search"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/search_bar_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_win11_search"
                    app:tint="#88000000"
                    android:contentDescription="Search" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Search"
                    android:textColor="#88000000"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>

        <!-- ── CENTER: Pinned icons ──────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Task View -->
            <FrameLayout
                android:id="@+id/btn_taskbar_taskview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_ripple"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_taskview"
                    app:tint="#FF444444"
                    android:contentDescription="Task View" />
            </FrameLayout>

            <!-- File Explorer -->
            <FrameLayout
                android:id="@+id/btn_taskbar_explorer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_ripple"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_folder"
                    android:contentDescription="File Explorer" />
            </FrameLayout>

            <!-- Edge / Browser -->
            <FrameLayout
                android:id="@+id/btn_taskbar_browser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_ripple"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_edge"
                    android:contentDescription="Browser" />
            </FrameLayout>

            <!-- Settings -->
            <FrameLayout
                android:id="@+id/btn_taskbar_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/taskbar_icon_ripple"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_win11_settings"
                    app:tint="#FF444444"
                    android:contentDescription="Settings" />
            </FrameLayout>

            <!-- Dynamic window icons injected here -->
            <LinearLayout
                android:id="@+id/taskbar_items_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </LinearLayout>

        <!-- ── RIGHT: System tray ────────────────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <!-- Tray icons + clock (clickable → control center) -->
            <LinearLayout
                android:id="@+id/taskbar_system_tray"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/taskbar_icon_ripple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <!-- Network -->
                <ImageView
                    android:id="@+id/tray_network"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@android:drawable/ic_menu_upload"
                    android:rotation="180"
                    app:tint="#FF444444"
                    android:contentDescription="Network" />

                <!-- Volume -->
                <ImageView
                    android:id="@+id/tray_volume"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="5dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="#FF444444"
                    android:contentDescription="Volume" />

                <!-- Battery -->
                <TextView
                    android:id="@+id/tray_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="🔋"
                    android:textSize="13sp" />

                <!-- Clock + Date -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/taskbar_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00 PM"
                        android:textColor="#FF1A1A1A"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/taskbar_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5/4/2026"
                        android:textColor="#88000000"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif" />
                </LinearLayout>

            </LinearLayout>

            <!-- Notification badge -->
            <FrameLayout
                android:id="@+id/btn_notifications"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="3dp"
                android:background="@drawable/taskbar_icon_ripple"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/notification_count"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:background="@drawable/win11_active_indicator"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:visibility="invisible" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
