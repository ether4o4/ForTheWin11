<?xml version="1.0" encoding="utf-8"?>
<!-- Win11 Start Menu — split layout matching WinX: left=all apps, right=pinned+recommended -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/start_menu_light"
    android:orientation="vertical"
    android:elevation="32dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ── Search Bar ──────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/search_bar_light"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_win11_search"
            app:tint="#88000000"
            android:contentDescription="Search icon" />

        <EditText
            android:id="@+id/start_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Search apps, settings, files…"
            android:textColor="#FF000000"
            android:textColorHint="#88000000"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            android:inputType="text"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch"
            android:singleLine="true" />
    </LinearLayout>

    <!-- ── Split content area ──────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/pinned_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ── LEFT: All Apps scrollable list ──────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All apps"
                android:textColor="#FF1A1A1A"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="16dp">

                <LinearLayout
                    android:id="@+id/all_apps_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Thin vertical divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#12000000"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- ── RIGHT: Pinned + Recommended ─────────────────────── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Pinned header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pinned"
                android:textColor="#FF1A1A1A"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="6dp" />

            <!-- Pinned grid — 3 columns -->
            <GridLayout
                android:id="@+id/pinned_apps_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="3" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#12000000"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <!-- Recommended header -->
            <LinearLayout
                android:id="@+id/recommended_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingBottom="4dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Recommended"
                        android:textColor="#FF1A1A1A"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="4dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="More ›"
                        android:textColor="#88000000"
                        android:textSize="11sp"
                        android:paddingEnd="4dp" />
                </LinearLayout>

                <!-- Recommended items -->
                <LinearLayout
                    android:id="@+id/recommended_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Divider above power bar ─────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#12000000"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />

    <!-- ── Power / Account bar ─────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal">

        <!-- Avatar / Account -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/win11_active_indicator" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textColor="#FF1A1A1A"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Local Account"
                    android:textColor="#88000000"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings -->
        <FrameLayout
            android:id="@+id/btn_settings_quick"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/taskbar_icon_ripple"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_win11_settings"
                app:tint="#FF444444"
                android:contentDescription="Settings" />
        </FrameLayout>

        <!-- Lock -->
        <FrameLayout
            android:id="@+id/btn_lock_quick"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/taskbar_icon_ripple"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔒"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Sleep -->
        <FrameLayout
            android:id="@+id/btn_moon_quick"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/taskbar_icon_ripple"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🌙"
                android:textSize="14sp" />
        </FrameLayout>

        <!-- Power -->
        <FrameLayout
            android:id="@+id/btn_power"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/taskbar_icon_ripple"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⏻"
                android:textColor="#FF444444"
                android:textSize="14sp" />
        </FrameLayout>

    </LinearLayout>

    <!-- Hidden search results (shown when typing, replaces split view) -->
    <ScrollView
        android:id="@+id/all_apps_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:id="@+id/search_results_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </ScrollView>

</LinearLayout>
