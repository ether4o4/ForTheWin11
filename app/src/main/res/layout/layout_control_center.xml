<?xml version="1.0" encoding="utf-8"?>
<!-- Win11 Control Center — frosted glass, real notifications, sliders, toggles -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_center_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Resize handle strip — left edge, drag to widen/narrow panel -->
    <View
        android:id="@+id/cc_resize_handle"
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#00000000" />

    <!-- Glass panel body -->
    <ScrollView
        android:id="@+id/cc_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/control_center_glass"
        android:elevation="28dp"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <!-- ── QUICK TOGGLES ────────────────────────────────── -->
            <GridLayout
                android:id="@+id/cc_toggles_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginBottom="16dp">

                <!-- Wi-Fi -->
                <LinearLayout
                    android:id="@+id/toggle_wifi"
                    android:layout_width="0dp"
                    android:layout_height="66dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/toggle_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <ImageView
                        android:id="@+id/ic_wifi"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_upload"
                        android:rotation="180"
                        app:tint="#FFE81123"
                        android:contentDescription="Wi-Fi" />
                    <TextView
                        android:id="@+id/lbl_wifi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Wi-Fi"
                        android:textColor="#FFE81123"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Bluetooth -->
                <LinearLayout
                    android:id="@+id/toggle_bluetooth"
                    android:layout_width="0dp"
                    android:layout_height="66dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/toggle_chip_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <ImageView
                        android:id="@+id/ic_bluetooth"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_win11_edge"
                        app:tint="#88000000"
                        android:contentDescription="Bluetooth" />
                    <TextView
                        android:id="@+id/lbl_bluetooth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Bluetooth"
                        android:textColor="#88000000"
                        android:textSize="9sp"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Airplane -->
                <LinearLayout
                    android:id="@+id/toggle_airplane"
                    android:layout_width="0dp"
                    android:layout_height="66dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/toggle_chip_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="✈"
                        android:textColor="#88000000"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/lbl_airplane"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Airplane"
                        android:textColor="#88000000"
                        android:textSize="9sp"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Night Light -->
                <LinearLayout
                    android:id="@+id/toggle_night"
                    android:layout_width="0dp"
                    android:layout_height="66dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="3dp"
                    android:background="@drawable/toggle_chip_off"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:text="🌙"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/lbl_night"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Night"
                        android:textColor="#88000000"
                        android:textSize="9sp"
                        android:maxLines="1" />
                </LinearLayout>

            </GridLayout>

            <!-- ── BRIGHTNESS ────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:text="☀"
                    android:textSize="14sp"
                    android:textColor="#88000000" />
                <SeekBar
                    android:id="@+id/brightness_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:max="255"
                    android:progress="200"
                    android:progressTint="#FFE81123"
                    android:thumbTint="#FFE81123" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_win11_settings"
                    app:tint="#88000000"
                    android:contentDescription="Display settings" />
            </LinearLayout>

            <!-- ── VOLUME ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_lock_silent_mode_off"
                    app:tint="#88000000"
                    android:contentDescription="Volume" />
                <SeekBar
                    android:id="@+id/volume_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="#FFE81123"
                    android:thumbTint="#FFE81123" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_win11_settings"
                    app:tint="#88000000"
                    android:contentDescription="Sound settings" />
            </LinearLayout>

            <!-- ── BATTERY ROW ───────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/battery_percent"
                    android:text="🔋 100%"
                    android:textColor="#CC000000"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/btn_more_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings ›"
                    android:textColor="#FFE81123"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#14000000"
                android:layout_marginBottom="14dp" />

            <!-- ── NOTIFICATIONS HEADER ──────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">
                <TextView
                    android:id="@+id/cc_notif_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notifications"
                    android:textColor="#FF000000"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/btn_clear_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear all"
                    android:textColor="#FFE81123"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- ── LIVE NOTIFICATIONS ────────────────────────────── -->
            <LinearLayout
                android:id="@+id/notification_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="6dp" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/cc_notif_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔕"
                    android:textSize="28sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No new notifications"
                    android:textColor="#88000000"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
