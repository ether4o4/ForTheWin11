<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_base"
    android:orientation="horizontal">

    <!-- Left Sidebar -->
    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="match_parent"
        android:background="#121212"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/explorer_sidebar_container">
            <!-- Items like Home, Gallery, OneDrive, etc. -->
        </LinearLayout>

    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1A1A1A"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ New"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackground" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#33FFFFFF" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_edit" app:tint="@color/text_dim" android:layout_marginEnd="12dp" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_share" app:tint="@color/text_dim" android:layout_marginEnd="12dp" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_delete" app:tint="@color/text_dim" android:layout_marginEnd="12dp" />

            <View android:layout_width="1dp" android:layout_height="24dp" android:background="#33FFFFFF" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:padding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:padding="8dp" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_info_details" app:tint="@color/text_dim" />
        </LinearLayout>

        <!-- Navigation/Address Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_revert" app:tint="@color/text_dim" android:layout_marginEnd="12dp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_revert" android:scaleX="-1" app:tint="@color/text_dim" android:layout_marginEnd="12dp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_directions" app:tint="@color/text_dim" android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="#22FFFFFF"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:layout_marginEnd="12dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/text_dim" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="200dp"
                android:layout_height="32dp"
                android:background="#22FFFFFF"
                android:gravity="center_vertical"
                android:paddingStart="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Home"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_menu_search" app:tint="@color/text_dim" android:layout_marginEnd="8dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Content Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick access"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <GridLayout
                    android:id="@+id/quick_access_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:layout_marginTop="16dp"
                    android:alignmentMode="alignMargins">
                    <!-- Dynamic Folder items -->
                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="32dp" />

                <LinearLayout
                    android:id="@+id/recent_files_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">
                    <!-- Dynamic File items -->
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
