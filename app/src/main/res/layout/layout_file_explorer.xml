<?xml version="1.0" encoding="utf-8"?>
<!-- Win11 File Explorer — white theme matching reference screenshots -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="horizontal">

    <!-- ── Left Sidebar ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:background="#FFFAFAFA"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/explorer_sidebar_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

    <!-- Vertical divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#18000000" />

    <!-- ── Main Content ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Command bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#FFF5F5F5"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/quick_toggle_off"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="+ New"
                android:textColor="#FF000000"
                android:textSize="12sp" />

            <View android:layout_width="1dp" android:layout_height="20dp" android:background="#22000000" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" />

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_edit" app:tint="#88000000" android:layout_marginEnd="8dp" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_share" app:tint="#88000000" android:layout_marginEnd="8dp" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_delete" app:tint="#88000000" android:layout_marginEnd="8dp" />

            <View android:layout_width="1dp" android:layout_height="20dp" android:background="#22000000" android:layout_marginStart="2dp" android:layout_marginEnd="6dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sort" android:textColor="#88000000" android:textSize="12sp" android:padding="4dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View" android:textColor="#88000000" android:textSize="12sp" android:padding="4dp" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Details" android:textColor="#FF0078D4" android:textSize="12sp" android:padding="4dp" />
        </LinearLayout>

        <!-- Address / Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#FFFFFFFF"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_media_previous" app:tint="#88000000" android:layout_marginEnd="4dp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_media_next" app:tint="#44000000" android:layout_marginEnd="4dp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_media_rew" app:tint="#44000000" android:layout_marginEnd="4dp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#88000000" android:layout_marginEnd="6dp" />

            <!-- Breadcrumb -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="26dp"
                android:layout_weight="1"
                android:background="@drawable/quick_toggle_off"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp">
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_win11_folder" android:layout_marginEnd="6dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home  ›" android:textColor="#FF000000" android:textSize="12sp" />
            </LinearLayout>

            <!-- Search -->
            <LinearLayout
                android:layout_width="130dp"
                android:layout_height="26dp"
                android:background="@drawable/quick_toggle_off"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Search Home" android:textColor="#88000000" android:textSize="11sp" />
                <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_win11_search" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#18000000" />

        <!-- Scrollable content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Quick access header -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#88000000" android:textSize="14sp" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick access" android:textColor="#FF000000" android:textStyle="bold" android:textSize="13sp" />
                </LinearLayout>

                <!-- Quick access grid — 2 columns matching ref -->
                <GridLayout
                    android:id="@+id/quick_access_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="16dp" />

                <!-- Favorites header -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#88000000" android:textSize="14sp" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Favorites" android:textColor="#FF000000" android:textStyle="bold" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="After you've favorited some files, we'll show them here." android:textColor="#88000000" android:textSize="12sp" android:layout_marginBottom="16dp" />

                <!-- Recent header -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#88000000" android:textSize="14sp" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recent" android:textColor="#FF000000" android:textStyle="bold" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recent_files_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Item count footer -->
                <TextView
                    android:id="@+id/explorer_item_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7 items"
                    android:textColor="#88000000"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
