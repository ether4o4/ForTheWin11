<?xml version="1.0" encoding="utf-8"?>
<!-- Draggable widget wrapper with glass background and dismiss button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Drag handle bar at top -->
    <FrameLayout
        android:id="@+id/widget_drag_handle"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@drawable/widget_header_bg"
        android:clickable="true"
        android:focusable="true">

        <!-- Grip indicator -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_grip" />

        <!-- Dismiss button (X top-right) -->
        <TextView
            android:id="@+id/btn_widget_dismiss"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#88000000"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <!-- Widget content slot -->
    <FrameLayout
        android:id="@+id/widget_content_slot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_body_bg"
        android:clipChildren="false"
        android:clipToPadding="false" />

</LinearLayout>
