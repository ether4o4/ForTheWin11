<?xml version="1.0" encoding="utf-8"?>
<!-- Win11 floating window — ultra-glass chrome, layered shadow, frosted body -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window_chrome_bg"
    android:elevation="16dp"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ── Glass Title Bar ─────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/window_title_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/window_titlebar_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <!-- App icon -->
        <ImageView
            android:id="@+id/window_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_win11_folder"
            android:scaleType="fitCenter" />

        <!-- Title -->
        <TextView
            android:id="@+id/window_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Window"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Minimize ─ -->
        <FrameLayout
            android:id="@+id/btn_window_minimize"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:background="@drawable/win_btn_minmax_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="—"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />
        </FrameLayout>

        <!-- Maximize ⬜ -->
        <FrameLayout
            android:id="@+id/btn_window_maximize"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:background="@drawable/win_btn_minmax_glass"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⬜"
                android:textColor="#CCFFFFFF"
                android:textSize="11sp" />
        </FrameLayout>

        <!-- Close ✕ -->
        <FrameLayout
            android:id="@+id/btn_window_close"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:background="@drawable/win_btn_close_glass"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </FrameLayout>

    </LinearLayout>

    <!-- Window body separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#0C000000" />

    <!-- ── Content area ──────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/window_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFCFF"
        android:clipChildren="true" />

</LinearLayout>
