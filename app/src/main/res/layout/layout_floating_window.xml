<?xml version="1.0" encoding="utf-8"?>
<!-- Win11 floating window — white bg, proper title bar, portrait-friendly size -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/window_bg"
    android:elevation="12dp"
    android:orientation="vertical">

    <!-- ── Title Bar ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/window_title_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/window_titlebar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp">

        <ImageView
            android:id="@+id/window_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_win11_folder"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/window_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Window"
            android:textColor="#FF000000"
            android:textSize="12sp" />

        <!-- Min -->
        <TextView
            android:id="@+id/btn_window_minimize"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:background="@drawable/win_btn_minmax"
            android:gravity="center"
            android:text="—"
            android:textColor="#66000000"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Max -->
        <TextView
            android:id="@+id/btn_window_maximize"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:background="@drawable/win_btn_minmax"
            android:gravity="center"
            android:text="⬜"
            android:textColor="#66000000"
            android:textSize="11sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Close -->
        <TextView
            android:id="@+id/btn_window_close"
            android:layout_width="46dp"
            android:layout_height="36dp"
            android:background="@drawable/win_btn_close"
            android:gravity="center"
            android:text="✕"
            android:textColor="#CC000000"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── Content ────────────────────────────────────────────────────── -->
    <FrameLayout
        android:id="@+id/window_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
