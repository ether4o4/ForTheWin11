<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="600dp"
    android:layout_height="400dp"
    android:background="@drawable/glass_panel_obsidian"
    android:elevation="10dp"
    android:orientation="vertical">

    <!-- Title Bar (Draggable) -->
    <LinearLayout
        android:id="@+id/window_title_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/sidebar_item_active"
        android:backgroundTint="#20FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/window_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_gallery_black_24dp"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/window_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Window"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_window_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Content Area -->
    <FrameLayout
        android:id="@+id/window_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="1dp" />

</LinearLayout>
