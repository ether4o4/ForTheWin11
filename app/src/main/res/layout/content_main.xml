<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stonehenge_modern"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/app_bar_main">

    <!-- Desktop Icons Area -->
    <GridLayout
        android:id="@+id/desktop_icons_grid"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:columnCount="1"
        app:layout_constraintBottom_toTopOf="@+id/custom_taskbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
    </GridLayout>

    <!-- Sidebar Widgets Area -->
    <LinearLayout
        android:id="@+id/sidebar_widgets"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/custom_taskbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/layout_widget_clock" />
        <include layout="@layout/layout_widget_system" />

    </LinearLayout>

    <!-- Main Content Area -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_content_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:alpha="0.9"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@+id/custom_taskbar"
        app:layout_constraintEnd_toStartOf="@+id/sidebar_widgets"
        app:layout_constraintStart_toEndOf="@+id/desktop_icons_grid"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/mobile_navigation" />

    <!-- Floating Window Layer -->
    <FrameLayout
        android:id="@+id/floating_window_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- Custom Taskbar -->
    <include
        android:id="@+id/custom_taskbar"
        layout="@layout/layout_custom_taskbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Start Menu Panel -->
    <include
        android:id="@+id/start_menu_panel"
        layout="@layout/layout_start_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/custom_taskbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Control Center Panel -->
    <include
        android:id="@+id/control_center_panel"
        layout="@layout/layout_control_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/custom_taskbar"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
