<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="290dp"
    android:layout_height="300dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_margin="16dp">

    <!-- 3D Base Card -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_3d_gradient"
        android:elevation="8dp" />

    <!-- Glass Overlay Layer (Red/White Style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:background="@drawable/glass_box_red"
        android:translationZ="25dp" />

    <!-- Clock Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:translationZ="30dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clock_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="12"
                android:textColor="@color/white"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text=":"
                android:textColor="#80FFFFFF"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/clock_minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="00"
                android:textColor="@color/white"
                android:textSize="56sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="MONDAY, JAN 1"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Nested 3D Circles (Top Right Aesthetic) -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|end"
        android:translationZ="40dp">
        <View
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:alpha="0.1" />
        <View
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:alpha="0.2"
            android:translationZ="20dp" />
    </FrameLayout>

</FrameLayout>
