<?xml version="1.0" encoding="utf-8"?>
<!-- Live notification card — clean white glass, real app icon, dismiss -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/notification_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: app name + time + dismiss -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp">

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="App icon" />

        <TextView
            android:id="@+id/notif_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="App"
            android:textSize="10sp"
            android:textColor="#88000000"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="now"
            android:textSize="10sp"
            android:textColor="#88000000" />

        <View
            android:id="@+id/notif_dismiss"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/taskbar_icon_ripple"
            android:clickable="true"
            android:focusable="true" />

        <!-- ✕ overlaid on the hit-area -->
        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="-28dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="11sp"
            android:textColor="#66000000"
            android:clickable="false" />
    </LinearLayout>

    <!-- Row 2: dot + bold title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <View
            android:id="@+id/notif_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/win11_active_indicator" />

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Title"
            android:textSize="13sp"
            android:textColor="#FF000000"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Row 3: body -->
    <TextView
        android:id="@+id/notif_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Content"
        android:textSize="12sp"
        android:textColor="#CC000000"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
