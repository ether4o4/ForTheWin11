<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ForTheWin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/win11_accent</item>
        <item name="colorPrimaryVariant">@color/win11_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/win11_accent</item>
        <item name="colorSecondaryVariant">@color/win11_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/surface_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="Theme.ForTheWin.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.ForTheWin.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.ForTheWin.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
